# Localhost Japan profile. Copy to .env before use:
#   cp .env.example .env
#
# CPU/memory, META_MODE, and AREAS follow infra/docker/germany.env (country-scale).
# No backup, no rate limit, no domain/Traefik: this is a loopback-only instance.

OVERPASS_DATA_ROOT=./data
OVERPASS_IMPORT_URL=https://download.geofabrik.de/asia/japan-latest.osm.pbf
OVERPASS_DIFF_URL=https://download.geofabrik.de/asia/japan-updates/
OVERPASS_META_MODE=yes
OVERPASS_AREAS=yes
OVERPASS_CPUS=4
OVERPASS_MEMORY=8g

# local
OVERPASS_LOCAL_PORT=9998
